# Required by the current openai/gpt-4o LiteLLM configuration.
OPENAI_API_KEY=your-openai-api-key

# Optional; only needed if you switch to a Google model.
GOOGLE_API_KEY=your-google-api-key

# Optional ADK configuration; set to true only for enterprise/Vertex AI use.
GOOGLE_GENAI_USE_ENTERPRISE=false
